    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvAppBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:cardCornerRadius="100dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="@color/zxing_transparent">

                <com.google.android.material.appbar.AppBarLayout
                    android:id="@+id/topAppBarLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.appbar.MaterialToolbar
                        android:id="@+id/topAppBar"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:minHeight="?attr/actionBarSize"
                        app:menu="@menu/top_app_bar"
                        app:navigationIcon="@drawable/ic_profile"
                        app:subtitle="CRUX MDM"
                        app:subtitleCentered="true"
                        app:subtitleTextAppearance="@style/TopBarSubTitleTextAppearance" />

                </com.google.android.material.appbar.AppBarLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvRecentActivityTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:clickable="true"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/recent_activity"
                android:textColor="@color/black"
                android:textSize="20sp"
                app:drawableRightCompat="@drawable/ic_arrow_right"
                app:layout_constraintStart_toStartOf="@id/cvAppBar"
                app:layout_constraintTop_toBottomOf="@id/cvAppBar" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecentActivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvRecentActivityTitle"
                app:strokeColor="@color/zxing_transparent"
                tools:itemCount="1"
                tools:listitem="@layout/item_recent_activity">

            </androidx.recyclerview.widget.RecyclerView>

            <TextView
                android:id="@+id/appCatalogTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/app_catalog"
                android:textColor="@color/black"
                android:textSize="20sp"
                app:drawableRightCompat="@drawable/ic_arrow_right"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rvRecentActivity" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAppCatalog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/appCatalogTitle"
                tools:itemCount="1"
                tools:listitem="@layout/item_app_catalog" />

            <TextView
                android:id="@+id/deviceDetailsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/device_details"
                android:textColor="@color/black"
                android:textSize="20sp"
                app:drawableRightCompat="@drawable/ic_arrow_right"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rvAppCatalog" />

            <include
                android:id="@+id/deviceDetail"
                layout="@layout/device_detail_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>