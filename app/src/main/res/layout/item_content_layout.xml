<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginVertical="12dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvFolder"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        android:padding="16dp"
        app:strokeColor="@color/zxing_transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/ivFileIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            tools:srcCompat="@tools:sample/avatars"
            android:src="@drawable/ic_folder"
            android:contentDescription="app image" />

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_content_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/roboto_medium"
        android:maxLines="1"
        android:text="File Name"
        android:textSize="17sp"
        app:layout_constraintStart_toEndOf="@+id/cvFolder"
        app:layout_constraintTop_toTopOf="@+id/cvFolder" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_content_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_light"
        android:maxLines="1"
        android:text="12 MB"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/cvFolder"
        app:layout_constraintStart_toStartOf="@id/tv_content_name"
        app:layout_constraintTop_toBottomOf="@id/tv_content_name" />

<!--    <com.mikhaellopez.circularprogressbar.CircularProgressBar-->
    <ProgressBar
        android:id="@+id/pbDownload"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:visibility="invisible"
        android:max="100"
        android:progress="0"
        android:secondaryProgress="0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/btnDownload"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_download"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/pbDownload"
        app:layout_constraintEnd_toEndOf="@+id/pbDownload"/>

    <ImageView
        android:id="@+id/ivDownloaded"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:visibility="gone"
        android:src="@drawable/ic_file_downloaded"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/pbDownload"
        app:layout_constraintEnd_toEndOf="@+id/pbDownload"/>

</androidx.constraintlayout.widget.ConstraintLayout>